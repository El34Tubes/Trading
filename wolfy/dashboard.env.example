# Copy to .env on the VPS next to docker-compose.dashboard.yml.
# Do not commit a real .env file.

# Required: choose a strong private PIN/password for dashboard access.
WOLFY_DASHBOARD_PIN=change-this-strong-pin

# Required: Postgres connection for the Wolfy database.
# For a Docker network with a service named postgres:
# WOLFY_POSTGRES_DSN=postgresql://wolfy:REDACTED@postgres:5432/wolfy
# For a remote managed database, use its private/TLS connection string.
WOLFY_POSTGRES_DSN=postgresql://wolfy:REDACTED@postgres-host:5432/wolfy

# Optional: dashboard browser refresh interval in seconds.
WOLFY_DASHBOARD_REFRESH_SECONDS=60

# Optional: where manual notes / poll answers are stored inside the container.
WOLFY_DASHBOARD_NOTES=/data/dashboard_notes.json
